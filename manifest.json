{
  "manifest_version": 3,
  "name": "BuildMintZ Shield",
  "short_name": "BMZ Shield",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "description": "Local protection against known ad, tracking, and scam infrastructure.",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BuildMintZ Shield",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "security", "enabled": true, "path": "rules/security.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@buildmintz.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}